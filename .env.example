# Existing Express / AI configuration
PORT=3000
# Number of trusted reverse-proxy hops in front of this server; the AI rate
# limiter identifies clients by req.ip. 0 (local default) trusts no proxy.
# Production behind a trusted reverse proxy (e.g. Render's edge) must set the
# exact, operator-confirmed hop count as a positive integer. Never use the
# boolean "true": it trusts client-supplied X-Forwarded-For and lets any
# client pick its own rate-limit identity (the server rejects it and falls
# back to 0).
TRUST_PROXY_HOPS=0
# SERVER ONLY. Redis/Valkey connection URL (e.g. Render Key Value internal URL)
# for the shared, cross-instance AI rate limit and the Kitchen AI
# conversation-turn ledger. Empty keeps per-instance in-memory counting.
# Never commit a real value.
RATE_LIMIT_REDIS_URL=
CORS_EXTRA_ORIGIN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_IMPORT_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash
AI_CHAT_PROVIDER=groq
AI_IMPORT_PROVIDER=groq
OPENAI_VISION_MODEL=
OPENAI_TRANSCRIBE_MODEL=

# Supabase public project configuration. The URL and anon/publishable key may
# eventually be used by PWA/iOS clients, but Phase 0 uses them only on Express.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Phase 0.5 integration validation only. Remote verification refuses to run
# unless the environment is explicitly marked non-production.
SUPABASE_ENVIRONMENT=development
EXPRESS_API_BASE=http://127.0.0.1:3000
TEST_USER_A_EMAIL=
TEST_USER_A_PASSWORD=
TEST_USER_B_EMAIL=
TEST_USER_B_PASSWORD=

# Opt in only against an isolated development server. This consumes the
# current /api/me rate-limit bucket until its window expires.
AUTH_SMOKE_TEST_RATE_LIMIT=false
AUTH_SMOKE_RATE_LIMIT_REQUEST_CAP=70

# SERVER ONLY. Never expose this value to browser code, iOS configuration,
# logs, backups, or client-visible deployment variables.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
