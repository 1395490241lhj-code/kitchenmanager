      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "木耳用温热水发胀，摘足淘净；小白菜心淘洗干净；猪肝洗净去筋切成薄片；姜、蒜切成方片；葱切八分长节子；泡辣椒切成马耳朵节。",
            "measureMentions": [
              {
                "raw": "八分长节子",
                "dimension": "length",
                "normalized": null,
                "reason": "葱切段长度"
              }
            ]
          },
          {
            "order": 2,
            "summary": "在碗内将盐、水豆粉、红酱油加汤一两兑成滋汁；葱、姜、蒜、泡辣椒、木耳、小白菜心等小配料放于滋汁碗内。",
            "measureMentions": []
          },
          {
            "order": 3,
            "summary": "炒锅置旺火上放猪油，随即将猪肝用盐、水豆粉拌匀，待油烧至七成热时下锅炒，猪肝炒至散籽、发伸，立即放入配料合炒。",
            "measureMentions": [
              {
                "raw": "七成热",
                "dimension": "heat",
                "normalized": null,
                "reason": "油温火候描述"
              }
            ]
          },
          {
            "order": 4,
            "summary": "炒匀后倒入碗内滋汁，炒转起锅，放花椒面即成。",
            "measureMentions": []
          }
        ],
