      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "猪肉的泡泡肉部分加鸡蛋、干豆粉拌匀，在八成热油锅内炸成酥肉；渣渣肉部分用刀剁茸，加盐、水豆粉拌成肉馅；肥瘦净肉部分在汤中煮成熟肉（又名老肉）。",
            "measureMentions": [
              {
                "raw": "八成热",
                "dimension": "heat",
                "normalized": null,
                "reason": "油温火候描述"
              }
            ]
          },
          {
            "order": 2,
            "summary": "猪的心、舌、肚在清水中洗净后用开水煮一下（俗称“出水”），再刮洗干净煮成熟料。",
            "measureMentions": []
          },
          {
            "order": 3,
            "summary": "猪的干肉皮放入油锅中，用温油浸软，逐渐加热炸泡成响皮；明笋用温热水泡胀、洗净，撕成粗丝。",
            "measureMentions": []
          },
          {
            "order": 4,
            "summary": "酥肉、老肉和熟心、舌、肚分别切成长约二寸、宽约六分、厚约一分的片子；肉馅用刀尖刮成小指头粗细、呈三棱形的刀尖丸子；响皮、明笋切成长约一寸二的筷子条，用开水煮透漂起。",
            "measureMentions": [
              {
                "raw": "长约二寸、宽约六分、厚约一分",
                "dimension": "size",
                "normalized": null,
                "reason": "片子切法规格，长度单位不作质量换算"
              },
              {
                "raw": "小指头粗细",
                "dimension": "size",
                "normalized": null,
                "reason": "刀尖丸子粗细描述"
              },
              {
                "raw": "长约一寸二",
                "dimension": "length",
                "normalized": null,
                "reason": "响皮、明笋条子长度"
              }
            ]
          },
          {
            "order": 5,
            "summary": "用蒸碗将心、舌、肚放在碗内正中，周围分四角间隔摆放酥肉、老肉、刀尖元子和其余心、舌、肚片部分；用响皮、明笋装底子，加葱姜、花椒、盐、胡椒及汤少许，上笼蒸至酥肉泡发。",
            "measureMentions": []
          },
          {
            "order": 6,
            "summary": "翻倒入碗内灌汤，汤内加少许青叶菜、味精即成。",
            "measureMentions": []
          }
        ],
