      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "将活鸭宰杀后放尽血，褪毛，剖腹，去内脏（内脏整理后，可加葱、姜、蒜、泡红辣椒等，用油炒成鸭什件），洗净，剔去腿骨，宰成长约一寸二、宽约五分的条子。",
            "measureMentions": [
              {
                "raw": "长约一寸二、宽约五分",
                "dimension": "length",
                "normalized": null,
                "reason": "鸭条尺寸"
              }
            ]
          },
          {
            "order": 2,
            "summary": "青黄豆淘洗干净，除去蒙皮，沥干水。姜拍松，葱挽结，郫县豆瓣剁细。",
            "measureMentions": []
          },
          {
            "order": 3,
            "summary": "炒锅置旺火上，放化猪油烧至七成热，下鸭条、姜、葱、花椒一起，煸干水汽，煸出香味后铲起。就锅内余油烧热，下豆瓣煸至油泛红色时，掺汤二斤，汤开时用漏瓢打去豆瓣渣不用。接着放入鸭条，并加盐、酱油等调料，用盖盖好，在中火上焖（不时翻动），至鸭条五成炬时，下青豆、胡椒面入锅合匀再焖。一直焖到鸭条全炬时，拈去姜、葱，放味精、水豆粉，将汁收浓，起锅即成。",
            "measureMentions": [
              {
                "raw": "掺汤二斤",
                "dimension": "volume-or-mass",
                "normalized": null,
                "reason": "掺入的汤量，原文未注明是否为最终消耗量，按原文保留“二斤”不做单位换算判断"
              }
            ]
          }
