      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "选用个头均匀的小芋儿，刮洗干净，沥干水。将宰杀整理后的鸭子清洗干净，去掉大骨，砍成长约一寸二、宽约八分的条形块子。姜拍松，葱挽结。",
            "measureMentions": [
              {
                "raw": "长约一寸二、宽约八分",
                "dimension": "length",
                "normalized": null,
                "reason": "鸭条尺寸"
              }
            ]
          },
          {
            "order": 2,
            "summary": "炒锅置旺火上，放入猪油，油烧至七成热时放鸭条下锅，加姜、葱、花椒一起煸干水汽，出香味，下盐和酱油，再煸至鸭条上色时，掺汤烧开，撇去浮沫，移小火上加盖煨起。",
            "measureMentions": [
              {
                "raw": "七成热",
                "dimension": "heat",
                "normalized": null,
                "reason": "油温火候描述"
              }
            ]
          },
          {
            "order": 3,
            "summary": "待鸭条烧至五成粑时，加芋儿下锅一同烧。烧至全粑，即拈去姜、葱不用。然后放味精、水豆粉，将汁收浓起锅即成。",
            "measureMentions": [
              {
                "raw": "五成粑",
                "dimension": "doneness",
                "normalized": null,
                "reason": "鸭条软烂程度描述"
              }
            ]
          }
