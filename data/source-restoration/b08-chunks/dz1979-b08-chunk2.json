      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "选黄色鸭肝，清洗干净，用刀片成大片（注意不要片烂），放碗内，用水豆粉、盐少许拌匀。姜、蒜切片，葱和泡红辣椒切“马耳朵”节，鲜菜心洗净。",
            "measureMentions": []
          },
          {
            "order": 2,
            "summary": "另用一碗，将水豆粉（三分）、酱油、盐、白糖、味精、醋、汤等兑成滋汁。",
            "measureMentions": []
          },
          {
            "order": 3,
            "summary": "炒锅内放猪油，烧至六成热时，将鸭肝下锅炒，至散籽即依次下姜、葱、蒜、泡红辣椒及鲜菜心，同炒几下，烹入滋汁（烹时调料要搅匀），待汁收浓起锅即成。",
            "measureMentions": []
          }
        ],
