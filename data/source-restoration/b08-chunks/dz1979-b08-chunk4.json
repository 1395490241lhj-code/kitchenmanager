      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "鲫鱼剖腹，去鳞、腮、内脏以后用水清洗干净。用刀在鱼身两面划几刀，抹上盐腌二分钟。在锅内放菜油，油烧至六成热时，把鱼下锅煎成浅黄色，然后铲起待用。将肥瘦猪肉剁成细末，葱切二寸长的段，泡红辣椒去蒂去籽。",
            "measureMentions": [
              {
                "raw": "腌二分钟",
                "dimension": "time",
                "normalized": null,
                "reason": "抹盐腌制时间"
              },
              {
                "raw": "二寸长",
                "dimension": "length",
                "normalized": null,
                "reason": "葱段长度"
              }
            ]
          },
          {
            "order": 2,
            "summary": "炒锅置旺火上烧红，倒入菜油，下肉末煸至散籽、亮油、肉酥时，依次放入葱、泡红辣椒，再煸几下。然后下鱼，加醪糟汁、白糖、酱油及汤。在小火上烧五分钟后，翻面再烧，直到汤干，亮油时，拈鱼入盘，最后将锅内诸物合匀，挂在鱼上即可。",
            "measureMentions": [
              {
                "raw": "小火上烧五分钟",
                "dimension": "time",
