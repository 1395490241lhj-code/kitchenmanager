      "methodSummary": {
        "steps": [
          {
            "order": 1,
            "summary": "将牛的肋条肉洗净，宰成七分大小的块子；苤蓝去皮切成五分大小的方块。",
            "measureMentions": [
              {
                "raw": "七分大小",
                "dimension": "length",
                "normalized": null,
                "reason": "牛肉块尺寸，长度单位不作质量换算"
              },
              {
                "raw": "五分大小",
                "dimension": "length",
                "normalized": null,
                "reason": "苤蓝方块尺寸，长度单位不作质量换算"
              }
            ]
          },
          {
            "order": 2,
            "summary": "铝锅盛清水烧开放入宰好的牛肉，水以淹没牛肉一寸左右为宜，水再开时撇去浮沫；放入葱、姜、花椒、香料、盐、酱油等调料，加盖后放在小火上㸆至七成㸆。",
            "measureMentions": [
              {
                "raw": "淹没牛肉一寸左右",
                "dimension": "length",
                "normalized": null,
                "reason": "水面高出牛肉的高度"
              },
              {
                "raw": "七成㸆",
                "dimension": "doneness",
                "normalized": null,
                "reason": "火候成熟度描述"
              }
            ]
          },
          {
            "order": 3,
            "summary": "另用炒锅放油炒豆瓣，炒至豆瓣现红油时在锅内掺汤烧开，稍煮即沥去豆瓣渣不用，只将豆瓣汁水倒入煮牛肉的铝锅内。",
            "measureMentions": []
          },
          {
            "order": 4,
            "summary": "铝锅内牛肉㸆至快㸆时放入苤蓝同烧，一直烧到牛肉㸆烂即成。",
            "measureMentions": []
          }
        ],
